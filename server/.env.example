PORT=4000
DATABASE_URL=postgresql://localhost:5432/justinfluence
# Generate with: openssl rand -base64 32
# Must be 32+ characters in production, or the server refuses to start.
JWT_SECRET=your_jwt_secret_here
PHYLLO_CLIENT_ID=your_phyllo_sandbox_client_id
PHYLLO_SECRET=your_phyllo_sandbox_secret
PHYLLO_ENV=sandbox
PHYLLO_BASE_URL=https://api.sandbox.insightiq.ai
PHYLLO_WEBHOOK_SECRET=your_phyllo_webhook_secret

# Base URL used to build invite links, and the allowed CORS origin.
# In a single-service deploy set this to the deployment's own public URL;
# if unset, invite links fall back to the origin the request arrived on.
FRONTEND_URL=http://localhost:5173

# Optional. 'disable' forces plaintext, 'require' forces TLS. When unset,
# TLS is used in production (with relaxed verification, as managed Postgres
# providers use self-signed certs) and disabled otherwise.
# PGSSLMODE=disable
